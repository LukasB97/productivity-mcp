<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProductivityMcp.App.ViewModels"
        x:Class="ProductivityMcp.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Productivity MCP"
        Width="780" Height="760" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" RequestedThemeVariant="Light"
        Opened="MainWindow_OnOpened">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E5EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5B6270" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5050C8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16" MaxWidth="780" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,8">
        <Border Width="44" Height="44" CornerRadius="11" Background="#5050C8">
          <TextBlock Text="P" Foreground="White" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Productivity MCP" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Kalender, Aufgaben und E-Mail für deinen KI-Assistenten" Classes="muted" />
        </StackPanel>
      </Grid>

      <Border Classes="card" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="10">
          <ProgressBar IsIndeterminate="True" Height="4" />
          <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusDetail}" Classes="muted" />
          <Button Content="Abbrechen" Command="{Binding CancelConnectionCommand}"
                  IsVisible="{Binding CanCancelConnection}" />
        </StackPanel>
      </Border>

      <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
              CornerRadius="10" Padding="16" IsVisible="{Binding HasFeedback}">
        <TextBlock Text="{Binding Feedback}" />
      </Border>

      <Border Classes="card" IsVisible="{Binding NeedsCredentials}">
        <StackPanel Spacing="12">
          <TextBlock Text="Google einrichten" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Für Kalender und Aufgaben wähle einmalig die OAuth-Datei aus der Google Cloud Console aus. E-Mail-Postfächer brauchen sie nicht." Classes="muted" />
          <WrapPanel IsEnabled="{Binding CanInteract}">
            <Button Classes="primary" Content="OAuth-Datei auswählen …" Click="ChooseCredentials_OnClick" />
            <Button Content="Nur E-Mail verbinden" Command="{Binding OpenEmailFormCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowConnectionAction}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusDetail}" Classes="muted" />
          <WrapPanel IsEnabled="{Binding CanInteract}">
            <Button Classes="primary" Content="Google: Kalender und Aufgaben" Command="{Binding ConnectCommand}" />
            <Button Content="E-Mail-Postfach verbinden" Command="{Binding OpenEmailFormCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEmailFormVisible}">
        <StackPanel Spacing="12">
          <TextBlock Text="E-Mail-Postfach verbinden" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted"
                     Text="Die App verbindet sich per IMAP und SMTP direkt mit deinem Postfach. Das Passwort wird verschlüsselt nur auf diesem Gerät gespeichert." />
          <StackPanel Spacing="4">
            <TextBlock Text="E-Mail-Adresse" FontWeight="SemiBold" />
            <TextBox Text="{Binding EmailAddress}" IsReadOnly="{Binding IsEmailAddressLocked}"
                     PlaceholderText="name@example.com" AutomationProperties.Name="E-Mail-Adresse" />
          </StackPanel>
          <Border Background="#F0F0FF" CornerRadius="8" Padding="14" IsVisible="{Binding ShowGmailHelp}">
            <StackPanel Spacing="6">
              <TextBlock Text="Gmail braucht ein App-Passwort" FontWeight="SemiBold" />
              <TextBlock Text="Dein normales Google-Passwort funktioniert hier nicht. Aktiviere die Bestätigung in zwei Schritten und erstelle dann ein App-Passwort. Firmen- und Schulkonten erlauben das oft nicht." />
              <HyperlinkButton Content="App-Passwort erstellen" NavigateUri="https://myaccount.google.com/apppasswords" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Text="Passwort oder App-Passwort" FontWeight="SemiBold" />
            <TextBox Text="{Binding EmailPassword}" PasswordChar="•" AutomationProperties.Name="Passwort oder App-Passwort" />
          </StackPanel>
          <Expander Header="Servereinstellungen" IsExpanded="{Binding ShowServerSettings}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
              <TextBlock Classes="muted" Text="Für bekannte Anbieter werden die Einstellungen automatisch ermittelt. Trage sie nur ein, wenn dein Anbieter andere Werte nennt." />
              <Button Content="Automatisch ermitteln" Command="{Binding DetectServerSettingsCommand}" />
              <Grid ColumnDefinitions="*,90,130" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="IMAP-Server (Empfang)" />
                <TextBlock Grid.Column="1" Text="Port" />
                <TextBlock Grid.Column="2" Text="Verschlüsselung" />
                <TextBox Grid.Row="1" Text="{Binding ImapHost}" AutomationProperties.Name="IMAP-Server" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImapPort}" AutomationProperties.Name="IMAP-Port" />
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{x:Static vm:MainWindowViewModel.SecurityChoices}"
                          SelectedIndex="{Binding ImapSecurityIndex}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="IMAP-Verschlüsselung" />
                <TextBlock Grid.Row="2" Text="SMTP-Server (Versand)" />
                <TextBox Grid.Row="3" Text="{Binding SmtpHost}" AutomationProperties.Name="SMTP-Server" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SmtpPort}" AutomationProperties.Name="SMTP-Port" />
                <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{x:Static vm:MainWindowViewModel.SecurityChoices}"
                          SelectedIndex="{Binding SmtpSecurityIndex}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="SMTP-Verschlüsselung" />
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Text="Benutzername (falls abweichend von der Adresse)" />
                <TextBox Text="{Binding MailUsername}" AutomationProperties.Name="Benutzername" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <TextBlock Text="{Binding EmailFormError}" IsVisible="{Binding HasEmailFormError}" Foreground="#9A3412" />
          <WrapPanel IsEnabled="{Binding CanInteract}">
            <Button Classes="primary" Content="Verbinden" Command="{Binding ConnectEmailCommand}" />
            <Button Content="Abbrechen" Command="{Binding CancelEmailFormCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding HasAccounts}" Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusDetail}" Classes="muted" />
          <WrapPanel IsEnabled="{Binding CanInteract}" Margin="0,6,0,0">
            <Button Content="Google-Konto hinzufügen" Command="{Binding AddAccountCommand}" />
            <Button Content="E-Mail-Postfach hinzufügen" Command="{Binding OpenEmailFormCommand}" />
            <Button Content="Verbindung prüfen" Command="{Binding RefreshCommand}" />
          </WrapPanel>
        </StackPanel>

        <Border IsVisible="{Binding IsDisconnectConfirmationVisible}" IsEnabled="{Binding CanInteract}" Background="#FFF7ED"
                BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding DisconnectAccountEmail, StringFormat='{}{0} wirklich trennen?'}" FontWeight="SemiBold" />
            <TextBlock Text="Die lokale Anmeldung und ein gespeichertes Mail-Passwort werden entfernt. Deine Daten beim Anbieter bleiben erhalten." />
            <WrapPanel>
              <Button Content="Abbrechen" Command="{Binding CancelDisconnectCommand}" />
              <Button Content="Konto trennen" Command="{Binding ConfirmDisconnectCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Accounts}" IsEnabled="{Binding CanInteract}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectedAccountViewModel">
              <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding Email}" FontSize="18" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <TextBlock Text="Kalender &amp; Aufgaben" />
                    <TextBlock Grid.Column="1" Text="{Binding CalendarTasksStatusText}" Classes="muted" />
                    <TextBlock Grid.Row="1" Text="E-Mail" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EmailStatusText}" Classes="muted" />
                  </Grid>
                  <TextBlock Text="{Binding ConnectionError}" IsVisible="{Binding HasConnectionError}" Foreground="#9A3412" />
                  <WrapPanel>
                    <Button Classes="primary" Content="Bei Google erneut anmelden" IsVisible="{Binding NeedsGoogleReconnect}"
                            Tag="{Binding Key}" Click="ReconnectAccount_OnClick" />
                    <Button Classes="primary" Content="Mail-Passwort erneuern" IsVisible="{Binding NeedsEmailReconnect}"
                            Tag="{Binding Email}" Click="RenewEmail_OnClick" />
                    <Button Content="{Binding EmailActionText}" Tag="{Binding}" Click="EmailAccount_OnClick" />
                    <Button Content="Konto trennen" Tag="{Binding Key}" Click="DisconnectAccount_OnClick" />
                  </WrapPanel>
                  <Expander Header="{Binding ResourceSummary}" IsVisible="{Binding CalendarTasksEnabled}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Kalender" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding Calendars}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConnectedResourceViewModel">
                            <StackPanel Margin="0,3" Spacing="2">
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Text="Standard" IsVisible="{Binding IsDefault}" Classes="muted" FontSize="11" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Aufgabenlisten" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding TaskLists}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConnectedResourceViewModel">
                            <StackPanel Margin="0,3" Spacing="2">
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Text="Standard" IsVisible="{Binding IsDefault}" Classes="muted" FontSize="11" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Expander Header="Einstellungen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="16">
          <Border Classes="card" IsVisible="{Binding IsAutostartSupported}">
            <StackPanel Spacing="8">
              <TextBlock Text="Beim Anmelden im Hintergrund starten" FontWeight="SemiBold" />
              <ToggleSwitch IsChecked="{Binding StartWithSystem}" OnContent="An" OffContent="Aus"
                            AutomationProperties.Name="Productivity MCP beim Anmelden starten" />
              <TextBlock Text="Der KI-Client startet den MCP-Server selbst. Der Autostart gilt nur für diese Konfigurations-App."
                         Classes="muted" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="E-Mail als Bild" FontWeight="SemiBold" />
              <TextBlock Text="Optionaler Chromium-Download. E-Mails werden lokal dargestellt; Text, HTML und Markdown funktionieren ohne ihn."
                         Classes="muted" />
              <TextBlock Text="Renderer installiert" Foreground="#16794A" IsVisible="{Binding IsRendererInstalled}" />
              <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsRendererBusy}" />
              <Button Content="Renderer installieren" Command="{Binding InstallRendererCommand}"
                      IsVisible="{Binding !IsRendererInstalled}" IsEnabled="{Binding !IsRendererBusy}" />
              <Button Content="Installation abbrechen" Command="{Binding CancelRendererCommand}"
                      IsVisible="{Binding IsRendererBusy}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <WrapPanel HorizontalAlignment="Center">
        <HyperlinkButton Content="Website" NavigateUri="https://lukasbrueckner.com/project/productivity-mcp" />
        <HyperlinkButton Content="Datenschutz" NavigateUri="https://lukasbrueckner.com/project/productivity-mcp/datenschutz" />
        <HyperlinkButton Content="Quellcode" NavigateUri="https://github.com/LukasB97/productivity-mcp" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
